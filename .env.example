# 42 Intra OAuth application credentials
# Create an app at https://profile.intra.42.fr/oauth/applications
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_API_BASE_URL=https://api.intra.42.fr

# Optional overrides (resolved automatically when empty)
FORTYTWO_CAMPUS_ID=
FORTYTWO_CURSUS_ID=21

# Postgres — `npm run db:up` starts one with these settings.
# The host port is deliberately not 5432: a locally installed Postgres (common
# on Windows) answers there first and rejects the ft42 login. If you change
# POSTGRES_PORT, keep the port in DATABASE_URL in step with it.
POSTGRES_USER=ft42
POSTGRES_PASSWORD=ft42
POSTGRES_DB=ft42_dashboard
POSTGRES_PORT=26542
DATABASE_URL=postgres://ft42:ft42@localhost:26542/ft42_dashboard

# Host port for the containerised app (`npm run docker:up`) — http://localhost:27942.
# Not used by `npm run dev`, which stays on 3000. Inside compose the app always
# reaches Postgres at postgres:5432, so the DATABASE_URL above is host-only.
APP_PORT=27942

# Day, week and hour boundaries (attendance forecast, "first in today", the
# Hall of Fame week) are all resolved in this timezone.
CAMPUS_TIMEZONE=Europe/Warsaw

# Where phones reach this app. Required for the teammate QR code and the bocal
# admin login; without it those features stay switched off and the rest of the
# board is unaffected.
#
# It must be the address a phone on campus wifi can open — not localhost, which
# a phone resolves to itself. Use the host's LAN address, or a hostname if the
# campus has DNS for it.
#
# Register `<APP_PUBLIC_URL>/api/auth/callback` as a redirect URI on the intra
# application at https://profile.intra.42.fr/oauth/applications — it has to
# match exactly, including the port.
APP_PUBLIC_URL=

# Signs the login cookie. Defaults to FORTYTWO_CLIENT_SECRET when unset, which
# is fine; set it explicitly to invalidate every session without rotating the
# 42 credentials. Any long random string works: `openssl rand -base64 32`.
SESSION_SECRET=

# development | production. In development, any signed-in 42 user can reach
# /admin (no staff? account needed) — handy for testing without a bocal
# account. In production only staff can. Unset or anything else defaults to
# production (fail secure); the Docker image ships APP_MODE=production.
APP_MODE=production
