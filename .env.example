# Copy to .env. See README.md for setup and descriptions.

# App: use a public URL reachable by campus devices.
APP_PUBLIC_URL=
APP_PORT=27942
APP_MODE=production
CAMPUS_TIMEZONE=Europe/Warsaw
SESSION_SECRET=

# PostgreSQL: keep DATABASE_URL in sync for local development.
POSTGRES_USER=ft42
POSTGRES_PASSWORD=ft42
POSTGRES_DB=ft42_dashboard
POSTGRES_PORT=26542
DATABASE_URL=postgres://ft42:ft42@localhost:26542/ft42_dashboard

# 42 Intra: required for campus data and 42 login.
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_API_BASE_URL=https://api.intra.42.fr
FORTYTWO_CAMPUS_ID=
FORTYTWO_CURSUS_ID=21
# Optional: defaults to APP_PUBLIC_URL + /api/auth/callback.
FORTYTWO_REDIRECT_URI=

# Pace: all five credentials are required for milestone syncing.
OIDC_OP_URL=
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
USER_LOGIN=
USER_PASSWORD=
PACE_URL=https://pace-system.42.fr/api/v1

# Optional: set in your test shell to enable PostgreSQL integration tests.
MILESTONES_TEST_DATABASE_URL=
