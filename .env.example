# 42 Intra OAuth application credentials
# Create an app at https://profile.intra.42.fr/oauth/applications
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_API_BASE_URL=https://api.intra.42.fr

# Optional overrides (resolved automatically when empty)
FORTYTWO_CAMPUS_ID=
FORTYTWO_CURSUS_ID=21

# Postgres — `npm run db:up` starts one with these settings.
# The host port is deliberately not 5432: a locally installed Postgres (common
# on Windows) answers there first and rejects the ft42 login. If you change
# POSTGRES_PORT, keep the port in DATABASE_URL in step with it.
POSTGRES_USER=ft42
POSTGRES_PASSWORD=ft42
POSTGRES_DB=ft42_dashboard
POSTGRES_PORT=26542
DATABASE_URL=postgres://ft42:ft42@localhost:26542/ft42_dashboard

# Host port for the containerised app (`npm run docker:up`) — http://localhost:27942.
# Not used by `npm run dev`, which stays on 3000. Inside compose the app always
# reaches Postgres at postgres:5432, so the DATABASE_URL above is host-only.
APP_PORT=27942

# Day, week and hour boundaries (attendance forecast, "first in today", the
# Hall of Fame week) are all resolved in this timezone.
CAMPUS_TIMEZONE=Europe/Warsaw
